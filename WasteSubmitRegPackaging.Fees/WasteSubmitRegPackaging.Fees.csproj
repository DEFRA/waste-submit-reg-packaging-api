<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Fees module: the fee tables (fee_*: groups, sub-groups, regulators, rates by date period) and
    the fee calculations. Shared by every workflow module.

    The data is owned by Liquibase changesets (changelog/changes/fees/), not by the service: the module
    only reads it. Other modules may join to the fee_* tables and hold foreign keys to them; in C# they
    use WasteSubmitRegPackaging.Fees.Contracts.

    Same layout as the other modules: Domain / Application / Infrastructure / Endpoints.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WasteSubmitRegPackaging.SharedKernel\WasteSubmitRegPackaging.SharedKernel.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.SharedKernel.Infrastructure\WasteSubmitRegPackaging.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.Fees.Contracts\WasteSubmitRegPackaging.Fees.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WasteSubmitRegPackagingApi.Test" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
