{
  "Postgres": {
    "Host": "localhost",
    "UseIamAuthentication": false,
    "SslMode": "Disable"
  },
  "Swagger": {
    "Enabled": true
  },
  "UnpublishedEndpoints": {
    "Enabled": true
  },
  "CommonDataApi": {
    "BaseUrl": "https://localhost:5001"
  },
  "DetailedErrors": true,
  "AllowedHosts": "*",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "{Timestamp:o} [{Level:u4}] ({Application}/{MachineName}/{ThreadId}/{SourceContext}.{Method}) {Message}{NewLine}{Exception}"
        }
      }
    ]
  }
}
