# Local requests for the skeleton's sample endpoints.
#
# Run them with Visual Studio 2022 (17.12+), Rider, or VS Code with the REST Client extension.
# Before you start:
#   1. docker compose up -d postgres && docker compose up liquibase   (database and schema)
#   2. Run WasteSubmitRegPackagingApi in the debugger (http://localhost:8085)
#
# Run the requests from top to bottom. Each one uses the id returned by "start".
#
# In Rider, if the chained ids aren't picked up, paste the registrationSubmissionId into @id.

@base = http://localhost:8085
@org = 11111111-1111-1111-1111-111111111111
@producer = 22222222-2222-2222-2222-222222222222
@regulator = 33333333-3333-3333-3333-333333333333
@id = {{start.response.body.$.registrationSubmissionId}}

### Health (anonymous)
GET {{base}}/health

### Database health (anonymous)
GET {{base}}/health/db

#######################################################################
# Registration: the happy path
#######################################################################

### 1. Producer starts a registration → 201
# The reference number must be unique, so it is random on each run.
# @name start
POST {{base}}/registrations
Content-Type: application/json
X-User-Id: {{producer}}
X-User-Type: Producer
X-Organisation-Id: {{org}}

{
  "organisationId": "{{org}}",
  "registrationYear": 2026,
  "journey": "DirectLargeProducer",
  "nation": "GB-ENG",
  "applicationReferenceNumber": "PEPR{{$randomInt 10000000 99999999}}"
}

### 2. Producer's view → status InProgress
GET {{base}}/registrations/{{id}}

### 3. Producer submits the application → 204
POST {{base}}/registrations/{{id}}/application-submission
Content-Type: application/json
X-User-Id: {{producer}}
X-User-Type: Producer
X-Organisation-Id: {{org}}

{ "comments": "Ready for review" }

### 4. Regulator's view → status SubmittedForApproval, availableRegulatorDecisions Grant, Refuse, Query
GET {{base}}/regulator/registrations/{{id}}

### 5. Regulator grants → 200, status Granted
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json
X-User-Id: {{regulator}}
X-User-Type: Regulator

{ "decision": "Grant" }

### 6. Grant again → 409 registration.decision_not_allowed (Granted only allows Cancel)
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json
X-User-Id: {{regulator}}
X-User-Type: Regulator

{ "decision": "Grant" }

#######################################################################
# Packaging: no registration needed first (producers report packaging data before registering)
#######################################################################

### 7. Start a packaging submission → 201, with registrationYear 2027 (packagingYear + 1)
# @name packaging
POST {{base}}/packaging/submissions
Content-Type: application/json
X-User-Id: {{producer}}
X-User-Type: Producer
X-Organisation-Id: {{org}}

{ "organisationId": "{{org}}", "packagingYear": 2026 }

### 8. Read it back
GET {{base}}/packaging/submissions/{{packaging.response.body.$.packagingSubmissionId}}

#######################################################################
# Errors: one of each kind
#######################################################################

### 400 user.missing: no X-User-* headers
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json

{ "decision": "Grant" }

### 400 ValidationProblem: decision missing, comments too long
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json
X-User-Id: {{regulator}}
X-User-Type: Regulator

{ "comments": "{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}{{$guid}}" }

### 400 registration.comments_required: Query without comments (a sample rule, see R5)
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json
X-User-Id: {{regulator}}
X-User-Type: Regulator

{ "decision": "Query" }

### 403 user.regulators_only: a producer tries to decide
POST {{base}}/regulator/registrations/{{id}}/decisions
Content-Type: application/json
X-User-Id: {{producer}}
X-User-Type: Producer
X-Organisation-Id: {{org}}

{ "decision": "Grant" }

### 404 registration.not_found
GET {{base}}/regulator/registrations/00000000-0000-0000-0000-000000000000

# ---- Fees and submission periods: no user headers needed ----

### Registration submission periods for 2026 (ids 3 to 6, as in the payment service)
GET {{base}}/submission-periods/registration?registrationYear=2026

### Packaging submission periods, each with the data periods it accepts
GET {{base}}/submission-periods/packaging

### The submission period a data period code is submitted in, with its dates
GET {{base}}/submission-periods/packaging?periodCode=2025-P0

### Tiles for a compliance scheme: every visible period, H2 and P0 together
GET {{base}}/submission-periods/packaging/for-submitter-type?submitterType=ComplianceScheme

### Tiles for a small direct producer: only the periods that accept P0
GET {{base}}/submission-periods/packaging/for-submitter-type?submitterType=DirectProducer&producerSize=Small

### One tile after it's chosen ("before you start"): July to December 2025 for a large producer, H2 only
GET {{base}}/submission-periods/packaging/July%20to%20December%202025/for-submitter-type?submitterType=DirectProducer&producerSize=Large

### Producer resubmission fee (flat): 80700 pence in 2026. The inputs are pencilled in; this will take a packagingSubmissionId
POST {{base}}/fees/packaging-resubmission
Content-Type: application/json

{ "submitter": "Producer", "regulator": "GB-ENG", "resubmissionDate": "2026-03-01T10:00:00Z" }

### Compliance scheme resubmission fee (per member), less a previous payment
POST {{base}}/fees/packaging-resubmission
Content-Type: application/json

{ "submitter": "ComplianceScheme", "regulator": "GB-WLS", "resubmissionDate": "2026-03-01T10:00:00Z", "memberCount": 3, "previousPayments": 51200 }

### 400 fees.no_rate_for_date: before the first rate
POST {{base}}/fees/packaging-resubmission
Content-Type: application/json

{ "submitter": "Producer", "regulator": "GB-ENG", "resubmissionDate": "2023-12-31T10:00:00Z" }
