<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The building blocks every module shares. It has no package or framework references on purpose:
    domain and application code must not depend on EF Core, ASP.NET Core or any transport.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

</Project>
