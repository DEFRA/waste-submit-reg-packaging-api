{
  "openapi": "3.1.1",
  "info": {
    "title": "Waste Submit Reg Packaging API",
    "description": "Packaging and registration data for EPR. The obligations endpoints serve aggregated packaging data from approved submissions. Endpoints that aren't published yet are in the unpublished document.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/describe": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Name of this service. Requires service-to-service authentication.",
        "operationId": "Describe",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DescribeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/packaging/{packagingYear}/submitter-organisation/{submitterOrganisationId}/producer-material-totals": {
      "get": {
        "tags": [
          "Packaging"
        ],
        "summary": "Material totals for each producer one submitter reported for",
        "description": "The producers one submitter reported for in the year: a direct registrant returns itself, a compliance scheme returns one item per member. Returns empty items when the submitter has no approved submission for the year, and 404 when the submitter organisation does not exist.",
        "operationId": "GetProducerMaterialTotals",
        "parameters": [
          {
            "name": "packagingYear",
            "in": "path",
            "description": "The packaging year, for example 2024.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "submitterOrganisationId",
            "in": "path",
            "description": "The submitter: a direct registrant's organisation ID, or a compliance scheme's ID.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemsResponseOfProducerPackaging"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/packaging/{packagingYear}/producer-material-totals-by-submitter": {
      "get": {
        "tags": [
          "Packaging"
        ],
        "summary": "Material totals for each producer, grouped by submitter",
        "description": "Every approved submission for the year, grouped by submitter, with each producer's material totals. Not paged. Returns empty items when the year has no approved submissions.",
        "operationId": "GetProducerMaterialTotalsBySubmitter",
        "parameters": [
          {
            "name": "packagingYear",
            "in": "path",
            "description": "The packaging year, for example 2024.",
            "required": true,
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemsResponseOfApprovedSubmission"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/fees/packaging-resubmission": {
      "post": {
        "tags": [
          "Fees"
        ],
        "summary": "Work out a packaging resubmission fee (inputs pencilled in)",
        "description": "Gives the same results as epr-payment-service's producer and compliance scheme resubmission-fee endpoints. Amounts are in pence. The request will change to take a packaging submission id.",
        "operationId": "CalculatePackagingResubmissionFee",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CalculatePackagingResubmissionFeeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResubmissionFee"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/submission-periods/registration": {
      "get": {
        "tags": [
          "Submission periods"
        ],
        "summary": "The registration submission periods, one per window type and registration year",
        "description": "The same rows and ids as epr-payment-service's [Lookup].[SubmissionPeriod]. Dates are midnight UTC.",
        "operationId": "GetRegistrationSubmissionPeriods",
        "parameters": [
          {
            "name": "registrationYear",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RegistrationSubmissionPeriod"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/submission-periods/packaging": {
      "get": {
        "tags": [
          "Submission periods"
        ],
        "summary": "Every packaging submission period, each with the data periods it accepts",
        "description": "For services. Replaces the SubmissionPeriods config in the packaging frontend and the POM validation function. Times are UK local time.",
        "operationId": "GetPackagingSubmissionPeriods",
        "parameters": [
          {
            "name": "periodCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PackagingSubmissionPeriod"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/submission-periods/packaging/for-submitter-type": {
      "get": {
        "tags": [
          "Submission periods"
        ],
        "summary": "The packaging submission periods a direct producer or compliance scheme can see now, as tiles",
        "description": "Newest year first. Each period lists the data periods this submitter can report (H1, H2, P0 ...). A compliance scheme gets every size; a direct producer gets only its size when producerSize is given. Times are UK local time. Dates and codes, not sentences, so the frontend can render English and Welsh.",
        "operationId": "GetPackagingSubmissionPeriodsForSubmitterType",
        "parameters": [
          {
            "name": "submitterType",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionPeriodsSubmitterType"
            }
          },
          {
            "name": "producerSize",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ProducerSize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PackagingSubmissionPeriodTile"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    },
    "/submission-periods/packaging/{submissionPeriod}/for-submitter-type": {
      "get": {
        "tags": [
          "Submission periods"
        ],
        "summary": "One packaging submission period as a submitter sees it, for the pages after a tile is chosen",
        "description": "The submission period is its name, for example 'January to June 2026'. 404 if it doesn't exist, isn't visible yet, or has no data periods for this submitter.",
        "operationId": "GetPackagingSubmissionPeriodForSubmitterType",
        "parameters": [
          {
            "name": "submissionPeriod",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "submitterType",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/SubmissionPeriodsSubmitterType"
            }
          },
          {
            "name": "producerSize",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ProducerSize"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PackagingSubmissionPeriodTile"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing or wrong client credentials."
          },
          "403": {
            "description": "The client doesn't have the scope this endpoint needs."
          }
        },
        "security": [
          {
            "basic": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ApprovedSubmission": {
        "required": [
          "submitterOrganisationId",
          "submitterType",
          "producers"
        ],
        "type": "object",
        "properties": {
          "submitterOrganisationId": {
            "type": "string",
            "description": "The submitter: a direct registrant's organisation ID, or a compliance scheme's ID. A scheme's ID is not the organisation ID of the company that runs it.",
            "format": "uuid"
          },
          "submitterType": {
            "description": "Whether the submitter is a direct registrant or a compliance scheme.",
            "$ref": "#/components/schemas/SubmitterType"
          },
          "producers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProducerPackaging"
            },
            "description": "The producers the submitter reported for: itself for a direct registrant, its members for a compliance scheme."
          }
        }
      },
      "CalculatePackagingResubmissionFeeRequest": {
        "required": [
          "submitter",
          "regulator",
          "resubmissionDate"
        ],
        "type": "object",
        "properties": {
          "submitter": {
            "$ref": "#/components/schemas/Submitter"
          },
          "regulator": {
            "$ref": "#/components/schemas/RegulatorNation"
          },
          "resubmissionDate": {
            "type": "string",
            "format": "date-time"
          },
          "memberCount": {
            "maximum": 100000,
            "minimum": 0,
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "previousPayments": {
            "maximum": 1000000000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "DescribeResponse": {
        "required": [
          "service"
        ],
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          }
        }
      },
      "EventAction": {
        "enum": [
          "Joined",
          "Left"
        ],
        "type": "string"
      },
      "FeeLine": {
        "required": [
          "feeRateId",
          "feeGroupId",
          "description",
          "unitPrice",
          "quantity",
          "amount"
        ],
        "type": "object",
        "properties": {
          "feeRateId": {
            "type": "integer",
            "format": "int32"
          },
          "feeGroupId": {
            "type": "integer",
            "format": "int32"
          },
          "description": {
            "type": "string"
          },
          "unitPrice": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "quantity": {
            "type": "integer",
            "format": "int32"
          },
          "amount": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "ItemsResponseOfApprovedSubmission": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApprovedSubmission"
            },
            "description": "The results."
          }
        }
      },
      "ItemsResponseOfProducerPackaging": {
        "required": [
          "items"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProducerPackaging"
            },
            "description": "The results."
          }
        }
      },
      "LeaverJoinerEvent": {
        "required": [
          "code",
          "action",
          "date"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "The code from the registration file, numbered as in the GOV.UK registration file guidance. Joiner codes: 1, 2, 3, 7, 9, 15, 17, 19, 20. Leaver codes: 4, 5, 6, 8, 10, 11, 12, 13, 14, 16, 21.",
            "format": "int32"
          },
          "action": {
            "description": "Whether the organisation joined or left. Worked out from the code.",
            "$ref": "#/components/schemas/EventAction"
          },
          "date": {
            "type": "string",
            "description": "When the organisation joined or left.",
            "format": "date"
          }
        }
      },
      "MaterialWeight": {
        "required": [
          "materialCode",
          "kilograms"
        ],
        "type": "object",
        "properties": {
          "materialCode": {
            "type": "string",
            "description": "The two-letter material code, for example PL for plastic or GL for glass."
          },
          "kilograms": {
            "type": "integer",
            "description": "Kilograms, totalled across the accepted H1 and H2 submissions. Always a whole number.",
            "format": "int64"
          }
        }
      },
      "PackagingDataPeriod": {
        "required": [
          "code",
          "shortCode",
          "description",
          "startDate",
          "endDate",
          "producerSize"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "shortCode": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "startDate": {
            "type": "string",
            "format": "date"
          },
          "endDate": {
            "type": "string",
            "format": "date"
          },
          "producerSize": {
            "$ref": "#/components/schemas/ProducerSize"
          }
        }
      },
      "PackagingSubmissionPeriod": {
        "required": [
          "name",
          "year",
          "openingDate",
          "visibleFromDate",
          "deadlineDate",
          "registrationYear",
          "dataPeriods"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "openingDate": {
            "type": "string",
            "format": "date-time"
          },
          "visibleFromDate": {
            "type": "string",
            "format": "date-time"
          },
          "deadlineDate": {
            "type": "string",
            "format": "date-time"
          },
          "registrationYear": {
            "type": "integer",
            "format": "int32"
          },
          "dataPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagingDataPeriod"
            }
          }
        }
      },
      "PackagingSubmissionPeriodTile": {
        "required": [
          "name",
          "year",
          "openingDate",
          "deadlineDate",
          "isOpen",
          "dataPeriods"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "format": "int32"
          },
          "openingDate": {
            "type": "string",
            "format": "date-time"
          },
          "deadlineDate": {
            "type": "string",
            "format": "date-time"
          },
          "isOpen": {
            "type": "boolean"
          },
          "dataPeriods": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PackagingDataPeriod"
            }
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "type": [
              "null",
              "integer"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProducerPackaging": {
        "required": [
          "producerOrganisationId",
          "events",
          "materials"
        ],
        "type": "object",
        "properties": {
          "producerOrganisationId": {
            "type": "string",
            "description": "The producer the packaging belongs to.",
            "format": "uuid"
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LeaverJoinerEvent"
            },
            "description": "Each time the producer joined or left during the year, oldest first. Empty when it did neither."
          },
          "materials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MaterialWeight"
            },
            "description": "Packaging totals, one per material."
          }
        }
      },
      "ProducerSize": {
        "enum": [
          "Large",
          "Small"
        ],
        "type": "string"
      },
      "RegistrationSubmissionPeriod": {
        "required": [
          "id",
          "windowType",
          "registrationYear",
          "openingDate",
          "deadlineDate",
          "closingDate"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int32"
          },
          "windowType": {
            "type": "string"
          },
          "registrationYear": {
            "type": "integer",
            "format": "int32"
          },
          "openingDate": {
            "type": "string",
            "format": "date-time"
          },
          "deadlineDate": {
            "type": "string",
            "format": "date-time"
          },
          "closingDate": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RegulatorNation": {
        "enum": [
          "GB-ENG",
          "GB-SCT",
          "GB-WLS",
          "GB-NIR"
        ],
        "type": "string"
      },
      "ResubmissionFee": {
        "required": [
          "lines",
          "totalResubmissionFee",
          "previousPayments",
          "outstandingPayment",
          "memberCount"
        ],
        "type": "object",
        "properties": {
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeeLine"
            }
          },
          "totalResubmissionFee": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "previousPayments": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "outstandingPayment": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "memberCount": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SubmissionPeriodsSubmitterType": {
        "enum": [
          "DirectProducer",
          "ComplianceScheme"
        ],
        "type": "string"
      },
      "Submitter": {
        "enum": [
          "Producer",
          "ComplianceScheme"
        ],
        "type": "string"
      },
      "SubmitterType": {
        "enum": [
          "DirectRegistrant",
          "ComplianceScheme"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "basic": {
        "type": "http",
        "description": "The client id and secret from Acl:Clients. Locally: Developer / developer-pwd.",
        "scheme": "basic"
      }
    }
  },
  "tags": [
    {
      "name": "Service"
    },
    {
      "name": "Packaging"
    },
    {
      "name": "Fees"
    },
    {
      "name": "Submission periods"
    }
