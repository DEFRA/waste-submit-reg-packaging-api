<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.8" />
    <PackageReference Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.16.0" />
    <PackageReference Include="Verify.XunitV3" Version="31.28.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WasteSubmitRegPackagingApi\WasteSubmitRegPackagingApi.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.Registration\WasteSubmitRegPackaging.Registration.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.Packaging\WasteSubmitRegPackaging.Packaging.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.Fees\WasteSubmitRegPackaging.Fees.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.SubmissionPeriods\WasteSubmitRegPackaging.SubmissionPeriods.csproj" />
  </ItemGroup>

  <!-- The database tests apply the real Liquibase changelog to a throwaway Postgres. -->
  <ItemGroup>
    <None Include="..\changelog\**\*" LinkBase="changelog" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>