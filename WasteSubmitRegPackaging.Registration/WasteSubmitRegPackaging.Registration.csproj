<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The Registration module (sample). Only RegistrationModule (AddRegistrationModule /
    MapRegistrationEndpoints) is public; everything else is internal. Other modules use
    WasteSubmitRegPackaging.Registration.Contracts.

    Folders are layers:
      Domain/          aggregate, state machine, domain events. No EF, no ASP.NET.
      Application/     one folder per use case: command or query, handler, result.
      Infrastructure/  DbContext, EF mappings, repository, Contracts implementation.
      Endpoints/       minimal API routes and request shapes.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WasteSubmitRegPackaging.SharedKernel\WasteSubmitRegPackaging.SharedKernel.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.SharedKernel.Infrastructure\WasteSubmitRegPackaging.SharedKernel.Infrastructure.csproj" />
    <ProjectReference Include="..\WasteSubmitRegPackaging.Registration.Contracts\WasteSubmitRegPackaging.Registration.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="WasteSubmitRegPackagingApi.Test" />
    <!-- Lets NSubstitute mock internal interfaces. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
