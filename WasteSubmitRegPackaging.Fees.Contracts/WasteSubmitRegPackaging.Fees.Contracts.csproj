<Project Sdk="Microsoft.NET.Sdk">

  <!--
    What the Fees module offers other modules: the fee calculations. Workflow modules reference this
    project, never WasteSubmitRegPackaging.Fees itself. Change it carefully, because it is a contract.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- For Result/Error only. The shared kernel has no dependencies of its own. -->
    <ProjectReference Include="..\WasteSubmitRegPackaging.SharedKernel\WasteSubmitRegPackaging.SharedKernel.csproj" />
  </ItemGroup>

</Project>
